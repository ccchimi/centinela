<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.centinela</groupId>
  <artifactId>centinela</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Centinela</name>
  <description>Motor de deteccion de fraude transaccional en tiempo real</description>

  <properties>
    <!--
      Baseline del lenguaje. Java 25 es LTS y es la version sobre la que Spring Boot 4.1
      certifica la compilacion nativa con GraalVM. Subir a 26 es cambiar este unico valor:
      todo el codigo del dominio compila igual en ambas (records, sealed types, pattern
      matching y virtual threads son finales desde Java 21).
    -->
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Parches de seguridad por encima del BOM de Spring Boot 4.1.1, detectados por Trivy en la
      imagen. Retirar cada uno cuando una version de Spring Boot traiga una igual o superior.
        tomcat:   CVE-2026-65182, CVE-2026-65905, CVE-2026-68525 (criticas)
        jackson:  CVE-2026-89407, CVE-2026-89425, CVE-2026-68497, CVE-2026-91776, CVE-2026-91777
    -->
    <tomcat.version>11.0.27</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>

    <!-- Versiones no gestionadas por el BOM de Spring Boot 4.1.1 -->
    <aws-sdk.version>2.54.2</aws-sdk.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <archunit.version>1.5.0</archunit.version>

    <!-- Plugins -->
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

    <!-- Nombre del ejecutable nativo (GraalVM) -->
    <native.image.name>centinela</native.image.name>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Transitiva de kafka-clients. CVE-2026-106451 corregida en 1.11.4. -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.11.4</version>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ==================== Nucleo Spring ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      Autenticacion de la API: valida JWT emitidos por un proveedor OIDC (Keycloak en local).
      Ver ConfiguracionDeSeguridad y THREAT_MODEL.md.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      Puente de trazas a OpenTelemetry y exportador OTLP.

      El actuator y micrometer-registry-prometheus por si solos dan METRICAS, no TRAZAS: la
      aplicacion ya emitia observaciones por la Observation API y honraba
      management.tracing.sampling.probability, pero sin exportador nadie las recogia y los
      spans se descartaban al cerrarse. Este starter es la pieza que faltaba en la cadena.

      Es el starter y no micrometer-tracing-bridge-otel a secas: en Spring Boot 4 la
      autoconfiguracion vive en el modulo spring-boot-micrometer-tracing-opentelemetry, y sin
      el las propiedades management.opentelemetry.* se ignorarian en silencio. Mismo motivo
      que spring-boot-starter-kafka mas abajo.

      Arrastra tambien micrometer-registry-otlp, cuyo export esta ACTIVO por defecto y
      empujaria metricas a un colector inexistente. Se apaga en application.yml: aqui las
      metricas se recogen por scraping de Prometheus.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>

    <!-- ==================== Mensajeria ==================== -->
    <!--
      El starter, no 'spring-kafka' a secas. En Spring Boot 4 las autoconfiguraciones se
      repartieron en modulos por tecnologia: sin spring-boot-starter-kafka no hay
      KafkaAutoConfiguration, las propiedades spring.kafka.* se ignoran en silencio y no
      existen los beans KafkaTemplate ni el contenedor de listeners.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>

    <!-- ==================== AWS (adaptadores de salida) ==================== -->
    <!--
      Cliente asincrono sobre Netty. Ver ADR-0002 en el README: se usa el mapeo manual a
      AttributeValue en lugar de dynamodb-enhanced porque el mapeo por bean del enhanced
      client necesita reflexion, y aqui todo el modelo son records con value objects que
      requeririan un conversor por componente.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>netty-nio-client</artifactId>
    </dependency>

    <!-- Contadores de velocidad en ElastiCache (Valkey/Redis) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!--
      Requisito de spring.data.redis.lettuce.pool.enabled=true: el starter NO lo arrastra y sin
      el, la fabrica de conexiones falla al arrancar con NoClassDefFoundError. El pool se usa
      para acotar la latencia de cola: Lettuce multiplexa sobre una unica conexion y, con miles
      de comandos concurrentes, el encolado en ese socket se nota en el percentil alto, que es
      justo el que vive dentro de la ventana de autorizacion.
    -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>

    <!-- ==================== Mapeo ==================== -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!-- ==================== Test ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      El slice @WebMvcTest tambien se separo en Boot 4: spring-boot-starter-test ya no lo trae.
      Sin esto, la anotacion sencillamente no existe en el classpath.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- jwt() de MockMvc: tokens sinteticos para probar las reglas de acceso sin un emisor. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Barreras de la arquitectura hexagonal verificadas como test. Se usa el artefacto core y
      no 'archunit-junit5': el motor de JUnit propio de ArchUnit añade un acoplamiento a la
      version de Jupiter que no necesitamos, y la API core se invoca igual desde un @Test.
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            Al declarar annotationProcessorPaths se desactiva el descubrimiento de
            procesadores por classpath: hay que listarlos todos aqui explicitamente.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${project.parent.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amapstruct.defaultComponentModel=spring</arg>
            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>reglas-de-entorno</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${java.version},)</version>
                  <message>Se requiere JDK ${java.version} o superior para compilar Centinela.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.6,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Pruebas de integracion (*IT) separadas de las unitarias -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Analisis de dependencias contra la base de vulnerabilidades del NVD (OWASP Dependency-Check).
      Uso:  NVD_API_KEY=... ./mvnw -Pseguridad verify -DskipTests
      Rompe el build si alguna dependencia tiene una vulnerabilidad con CVSS >= 7 (alta o critica).
      Los falsos positivos se descartan en dependency-check-suppressions.xml, siempre con el motivo.
    -->
    <profile>
      <id>seguridad</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>13.0.0</version>
            <configuration>
              <!-- Sin clave el NVD limita tanto las consultas que la primera descarga tarda horas. -->
              <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>SARIF</format>
              </formats>
              <suppressionFiles>
                <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
              <!-- Solo dependencias que viajan en el artefacto: las de test no llegan a produccion. -->
              <skipTestScope>true</skipTestScope>
              <!-- OSS Index exige credenciales desde 2025; el NVD alcanza para Maven. -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <!-- Proyecto Java puro: no hay JavaScript, .NET ni Node que analizar. -->
              <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
              <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
              <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Complementa el perfil 'native' que ya define spring-boot-starter-parent.
      Uso:  ./mvnw -Pnative native:compile
    -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <imageName>${native.image.name}</imageName>

              <!--
                Repositorio de metadata de accesibilidad de GraalVM. Es lo que hace viable esta
                compilacion: kafka-clients NO trae metadata propia (el SDK de AWS y Lettuce si),
                y sin este repositorio habria que escribir a mano la configuracion de reflexion
                del cliente de Kafka entero. Ver PistasDeImagenNativa para lo que si es nuestro.
              -->
              <metadataRepository>
                <enabled>true</enabled>
              </metadataRepository>

              <buildArgs>
                <buildArg>--enable-https</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>

                <!--
                  Sin esto, GraalVM compila para el micro donde corre el build (por defecto
                  x86-64-v3 o superior) y el binario revienta con SIGILL en cualquier maquina
                  mas antigua. Para una imagen que se publica en un registro y corre donde
                  toque, la portabilidad vale mas que el ultimo 5% de rendimiento.
                -->
                <buildArg>-march=compatibility</buildArg>

                <!--
                  Volcados de heap sobre un proceso nativo: la unica forma de investigar un
                  consumo raro cuando ya no hay JVM debajo. Se deja fuera 'jfr' a proposito,
                  porque embebe el registro completo de tipos de evento y engorda el binario
                  bastante mas de lo que aporta en un servicio que ya publica metricas.
                -->
                <buildArg>--enable-monitoring=heapdump</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
